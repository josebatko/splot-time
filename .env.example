# Bot token: OAuth & Permissions → Bot User OAuth Token (starts with xoxb-)
SLACK_BOT_TOKEN=
# App-level token with the connections:write scope: Basic Information → App-Level Tokens (starts with xapp-)
SLACK_APP_TOKEN=

# Comma-separated Slack user IDs of SplotTime admins (profile → ⋮ → Copy member ID)
ADMIN_USER_IDS=

# Optional
DATABASE_PATH=./data/splot-time.db
# Any Monday that starts a two-week cycle
BIWEEK_ANCHOR=2026-01-05
# Timezone that decides what "today" means
TZ=Europe/Bratislava
